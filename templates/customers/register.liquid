{% comment %}
  KAAZE EDTN Customer Registration Template
{% endcomment %}

<div class="flex flex-col items-center justify-center flex-1 py-space-xl px-margin font-mono">
  <div class="max-w-md w-full bg-surface-container-low border border-surface-container p-space-lg md:p-space-xl space-y-space-md">
    <div class="border-b border-surface-container pb-space-sm flex items-center justify-between">
      <span class="font-label-sm text-label-sm text-outline uppercase tracking-widest">
        [ CLIENT ENROLLMENT // REGISTRATION ]
      </span>
      <span class="text-xs text-primary font-bold">KAAZE</span>
    </div>

    <div>
      <h1 class="font-display-lg text-headline-lg uppercase text-primary font-sans font-bold leading-tight">
        REGISTER.
      </h1>
      <p class="font-body-sm text-on-surface-variant font-sans mt-1">
        Initialize your client identifier to track releases and manage dispatch orders.
      </p>
    </div>

    {% form 'create_customer', class: 'flex flex-col gap-space-sm' %}
      {% if form.errors %}
        <div class="p-space-xs bg-red-500/10 border border-red-500 text-red-500 text-xs">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="grid grid-cols-2 gap-space-xs">
        <div class="flex flex-col gap-1">
          <label for="FirstName" class="font-label-sm text-label-sm text-outline uppercase tracking-widest">
            FIRST NAME:
          </label>
          <input
            type="text"
            name="customer[first_name]"
            id="FirstName"
            autocomplete="given-name"
            required
            class="w-full bg-surface-container-lowest border border-surface-container p-3 font-mono text-xs text-primary focus:outline-none focus:border-primary uppercase"
            placeholder="ALEX"
          >
        </div>
        <div class="flex flex-col gap-1">
          <label for="LastName" class="font-label-sm text-label-sm text-outline uppercase tracking-widest">
            LAST NAME:
          </label>
          <input
            type="text"
            name="customer[last_name]"
            id="LastName"
            autocomplete="family-name"
            required
            class="w-full bg-surface-container-lowest border border-surface-container p-3 font-mono text-xs text-primary focus:outline-none focus:border-primary uppercase"
            placeholder="VANCE"
          >
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label for="CustomerEmail" class="font-label-sm text-label-sm text-outline uppercase tracking-widest">
          EMAIL COORDINATES:
        </label>
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          class="w-full bg-surface-container-lowest border border-surface-container p-3 font-mono text-xs text-primary focus:outline-none focus:border-primary uppercase"
          placeholder="USER@NETWORK.COM"
        >
      </div>

      <div class="flex flex-col gap-1">
        <label for="CreatePassword" class="font-label-sm text-label-sm text-outline uppercase tracking-widest">
          SECURITY KEY:
        </label>
        <input
          type="password"
          name="customer[password]"
          id="CreatePassword"
          autocomplete="new-password"
          required
          class="w-full bg-surface-container-lowest border border-surface-container p-3 font-mono text-xs text-primary focus:outline-none focus:border-primary"
          placeholder="MINIMUM 8 CHARACTERS"
        >
      </div>

      <div class="pt-space-xs">
        <button
          type="submit"
          class="w-full py-3.5 bg-primary text-on-primary font-label-md text-label-md uppercase tracking-[0.2em] font-bold border border-primary hover:bg-surface-container-high hover:text-primary transition-all cursor-pointer"
        >
          [ INITIALIZE ACCOUNT ]
        </button>
      </div>
    {% endform %}

    <div class="border-t border-surface-container pt-space-sm flex items-center justify-between text-xs text-outline">
      <span>EXISTING IDENTIFIER?</span>
      <a href="{{ routes.account_login_url }}" class="text-primary font-bold hover:underline uppercase">
        SIGN IN &rarr;
      </a>
    </div>
  </div>
</div>
