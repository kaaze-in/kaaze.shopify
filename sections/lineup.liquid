{% comment %}
  KAAZE EDTN The Lineup Section
  Core curated releases grid with brutalist metadata headers.
{% endcomment %}

<section class="w-full bg-surface px-margin md:px-margin-tablet lg:px-margin-desktop py-space-xl" id="the-lineup">
  <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-surface-container pb-space-md mb-space-lg gap-space-sm font-mono">
    <div>
      <div class="flex items-center gap-space-xs font-label-sm text-label-sm text-outline tracking-widest uppercase mb-space-xs">
        <span>{{ section.settings.eyebrow | default: 'CATALOGUE // DROP 01' }}</span>
        <span>•</span>
        <span class="text-primary">{{ section.settings.series | default: 'CORE RELEASES' }}</span>
      </div>
      <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg uppercase text-primary tracking-tight font-sans font-bold">
        {{ section.settings.heading | default: 'THE LINEUP.' }}
      </h2>
    </div>

    <div class="flex items-center gap-space-md">
      <a
        href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
        class="font-label-md text-label-md uppercase tracking-widest text-outline hover:text-primary transition-colors flex items-center gap-space-xs"
      >
        <span>{{ section.settings.view_all_text | default: 'EXPLORE FULL ARCHIVE' }}</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </div>

  <!-- Product Lineup Grid (4 Columns) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter-desktop">
    {% assign selected_collection = collections[section.settings.collection] | default: collections.all %}
    {% assign product_limit = section.settings.products_to_show | default: 4 %}

    {% for product in selected_collection.products limit: product_limit %}
      {% render 'product-card', product: product, card_variant: 'lineup' %}
    {% else %}
      {% for i in (1..4) %}
        <div class="p-space-lg bg-surface-container-lowest border border-surface-container text-center font-mono text-outline text-xs">
          [ ARTIFACT SPECIFICATION PENDING ]
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "The Lineup Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tag",
      "default": "CATALOGUE // DROP 01"
    },
    {
      "type": "text",
      "id": "series",
      "label": "Series Label",
      "default": "CORE RELEASES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "THE LINEUP."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "EXPLORE FULL ARCHIVE"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "The Lineup Grid"
    }
  ]
}
{% endschema %}
