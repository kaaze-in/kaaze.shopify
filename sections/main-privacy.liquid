{% comment %}
  KAAZE EDTN Privacy Policy & Purchase Terms Section
{% endcomment %}

<div class="flex flex-col w-full text-on-surface">
  <!-- Top Meta Bar -->
  <div class="w-full bg-surface-container-lowest px-margin md:px-margin-desktop py-space-sm border-b border-surface-container font-mono">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
      <div class="flex items-center gap-space-md flex-wrap">
        <span class="font-label-sm text-label-sm text-outline tracking-widest uppercase">
          [ PRIVACY DIRECTIVE // SEC-V04 ]
        </span>
        <span class="hidden sm:inline text-outline-variant">|</span>
        <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">
          DATA RETENTION &amp; SECURITY
        </span>
      </div>
      <span class="font-label-sm text-label-sm text-outline uppercase">
        {{ shop.name }}
      </span>
    </div>
  </div>

  <div class="w-full px-margin md:px-margin-desktop py-space-lg md:py-space-xl">
    <div class="max-w-4xl mx-auto flex flex-col space-y-space-xl">
      <!-- Header -->
      <div class="flex flex-col space-y-space-xs border-b border-surface-container pb-space-lg font-mono">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-outline">
          [ LEGAL PROTOCOL ]
        </span>
        <h1 class="font-display-xl text-display-xl-mobile md:text-display-xl uppercase tracking-tight text-primary leading-none m-0 font-sans font-bold">
          PRIVACY POLICY.
        </h1>
        <p class="font-headline-md text-headline-md text-primary uppercase tracking-wide mt-3 font-sans font-semibold">
          YOUR DATA. YOUR PRIVACY. CLEAR TERMS.
        </p>
      </div>

      <!-- Numbered Sections Grid -->
      <div class="space-y-space-md font-mono">
        <!-- 01 // CUSTOMER INFORMATION -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              01 // CUSTOMER INFORMATION
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            We collect personal details such as your name, shipping address, email, and phone number strictly for order fulfillment, dispatch communication, and transaction confirmations.
          </p>
        </section>

        <!-- 02 // PAYMENTS & CHECKOUT -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              02 // PAYMENTS &amp; CHECKOUT
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            Payments are processed securely via native Shopify payment gateways. KAAZE never stores full payment card credentials or CVV numbers on any server.
          </p>
        </section>

        <!-- 03 // COOKIES & WEBSITE DATA -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              03 // COOKIES &amp; WEBSITE DATA
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            Our platform uses essential session cookies to remember your allocated cart items, handle authentication status, and ensure smooth checkout processing.
          </p>
        </section>

        <!-- 04 // THIRD-PARTY SERVICES -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              04 // THIRD-PARTY SERVICES
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            Order coordinates are securely transmitted to verified central logistics couriers (DHL Express, Bluedart) solely for dispatch, waybill creation, and tracking notifications.
          </p>
        </section>

        <!-- 05 // YOUR PRIVACY RIGHTS -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              05 // YOUR PRIVACY RIGHTS
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            You maintain full rights to review, rectify, or request deletion of your account credentials under applicable data privacy frameworks.
          </p>
        </section>
      </div>

      <!-- Purchase Terms Directive Box (Acknowledgment) -->
      <div class="bg-surface-container-low border-2 border-primary p-space-md md:p-space-lg flex flex-col space-y-space-md font-mono">
        <div class="flex items-center justify-between border-b border-surface-container pb-2">
          <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest font-bold">
            [ PURCHASE TERMS DIRECTIVE ]
          </span>
          <span class="font-label-sm text-label-sm text-outline uppercase">
            ACKNOWLEDGEMENT REQUIRED
          </span>
        </div>

        <div class="space-y-space-xs">
          <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
            BEFORE YOU PROCEED
          </h2>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            Please review our purchase terms before placing your order.
          </p>
        </div>

        <ul class="space-y-3 font-sans font-body-md text-on-surface-variant border-y border-surface-container py-space-md">
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-mono font-bold leading-normal">•</span>
            <span>
              <strong class="text-primary font-semibold">No returns or exchanges:</strong> Purchases are final, subject to applicable consumer rights.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-mono font-bold leading-normal">•</span>
            <span>
              <strong class="text-primary font-semibold">Product details:</strong> Review the description, size, specifications, and images carefully before ordering.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-mono font-bold leading-normal">•</span>
            <span>
              <strong class="text-primary font-semibold">Third-party fulfilment:</strong> Products may be sourced and shipped by external suppliers or logistics partners.
            </span>
          </li>
        </ul>

        <!-- Interactive Acknowledgment Checkbox -->
        <div class="pt-space-xs">
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input
              type="checkbox"
              id="privacyTermsCheckbox"
              class="mt-1 h-4 w-4 rounded-none border-primary text-primary focus:ring-0 focus:ring-offset-0 cursor-pointer accent-black"
              onchange="document.getElementById('privacyProceedBtn').disabled = !this.checked; document.getElementById('privacyProceedBtn').classList.toggle('opacity-60', !this.checked); document.getElementById('privacyProceedBtn').classList.toggle('cursor-not-allowed', !this.checked);"
            >
            <span class="text-primary font-mono text-label-md uppercase tracking-wide font-medium">
              I have read and understood the purchase terms and no-return policy.
            </span>
          </label>
        </div>

        <!-- Action Buttons -->
        <div class="pt-space-sm flex flex-col sm:flex-row items-center gap-space-sm font-mono font-label-md text-label-md uppercase tracking-widest">
          <a
            href="{{ routes.cart_url }}"
            id="privacyProceedBtn"
            class="w-full sm:w-auto text-center px-6 py-3 bg-primary text-on-primary hover:bg-surface-container-high hover:text-primary transition-colors font-bold border border-primary opacity-60 cursor-not-allowed"
          >
            [ CONTINUE TO CHECKOUT ]
          </a>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="w-full sm:w-auto text-center px-6 py-3 border border-surface-container hover:border-primary text-on-surface hover:text-primary transition-colors font-semibold"
          >
            [ CANCEL ]
          </a>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="pt-space-md flex flex-col sm:flex-row items-center justify-between gap-space-sm border-t border-surface-container font-mono font-label-sm text-label-sm">
        <a href="{{ routes.all_products_collection_url }}" class="text-primary hover:underline underline-offset-4 uppercase font-semibold">
          &larr; EXPLORE CATALOGUE
        </a>
        <a href="/pages/shipping-returns" class="text-primary hover:underline underline-offset-4 uppercase font-semibold">
          SHIPPING &amp; LOGISTICS &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Privacy Policy",
  "settings": []
}
{% endschema %}
