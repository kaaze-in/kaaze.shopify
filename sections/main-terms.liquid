{% comment %}
  KAAZE EDTN Terms & Conditions Policy Section
{% endcomment %}

<div class="flex flex-col w-full text-on-surface">
  <!-- Top Meta Bar -->
  <div class="w-full bg-surface-container-lowest px-margin md:px-margin-desktop py-space-sm border-b border-surface-container font-mono">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
      <div class="flex items-center gap-space-md flex-wrap">
        <span class="font-label-sm text-label-sm text-outline tracking-widest uppercase">
          [ CONTRACT PROTOCOL // TC-2026 ]
        </span>
        <span class="hidden sm:inline text-outline-variant">|</span>
        <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">
          PURCHASE CONDITIONS &amp; AGREEMENTS
        </span>
      </div>
      <span class="font-label-sm text-label-sm text-outline uppercase">
        {{ shop.name }}
      </span>
    </div>
  </div>

  <div class="w-full px-margin md:px-margin-desktop py-space-lg md:py-space-xl">
    <div class="max-w-4xl mx-auto flex flex-col space-y-space-xl">
      <!-- Header -->
      <div class="flex flex-col space-y-space-xs border-b border-surface-container pb-space-lg font-mono">
        <span class="font-label-sm text-label-sm uppercase tracking-widest text-outline">
          [ LEGAL PROTOCOL ]
        </span>
        <h1 class="font-display-xl text-display-xl-mobile md:text-display-xl uppercase tracking-tight text-primary leading-none m-0 font-sans font-bold">
          TERMS &amp; CONDITIONS
        </h1>
        <p class="font-headline-md text-headline-md text-primary uppercase tracking-wide mt-3 font-sans font-semibold">
          PURCHASE TERMS, PRODUCT SOURCING &amp; CUSTOMER AGREEMENTS.
        </p>
      </div>

      <!-- Numbered Sections Grid -->
      <div class="space-y-space-md font-mono">
        <!-- 01 // PRODUCT SOURCING -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              01 // PRODUCT SOURCING &amp; AVAILABILITY
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            KAAZE sources fashion and lifestyle products from external brands, suppliers, and sellers. Product availability, specifications, and prices may change depending on supplier availability. Orders are subject to confirmation.
          </p>
        </section>

        <!-- 02 // ALL SALES FINAL -->
        <section class="bg-surface-container-low border-2 border-primary p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2 flex items-center justify-between">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              02 // ALL SALES FINAL (NO RETURNS OR REFUNDS)
            </h2>
            <span class="text-xs text-primary font-bold">[ BINDING CLAUSE ]</span>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            By completing a purchase on KAAZE, you acknowledge and agree that all sales are final. We do not provide refunds, returns, or exchanges for buyer preference, incorrect sizing, or dissatisfaction, unless required by mandatory consumer protection law.
          </p>
        </section>

        <!-- 03 // PRICING & PAYMENT -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              03 // PRICING &amp; PAYMENT
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            All prices are listed in your selected currency. We reserve the right to correct pricing errors and cancel orders placed at incorrect prices. Payments are processed securely via native checkout.
          </p>
        </section>

        <!-- 04 // SHIPPING & DELIVERY RISKS -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              04 // SHIPPING &amp; DELIVERY RISKS
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            Shipping and delivery timelines are estimates provided by suppliers and couriers. KAAZE is not responsible for transit delays, customs holds, or carrier failures once the order has been dispatched.
          </p>
        </section>

        <!-- 05 // LIMITATION OF LIABILITY -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              05 // LIMITATION OF LIABILITY
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            To the maximum extent permitted by applicable law, KAAZE shall not be liable for any indirect, incidental, or consequential damages resulting from product use, supplier delays, or service interruptions.
          </p>
        </section>

        <!-- 06 // USER RESPONSIBILITY -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              06 // USER RESPONSIBILITY
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            You agree to provide accurate, complete, and current information for all orders placed on our website. You are responsible for ensuring your address and contact information are correct.
          </p>
        </section>

        <!-- 07 // POLICY UPDATES -->
        <section class="bg-surface-container-low border border-surface-container p-space-md md:p-space-lg flex flex-col space-y-space-xs">
          <div class="border-b border-surface-container pb-2 mb-2">
            <h2 class="text-primary font-bold text-headline-md font-sans uppercase">
              07 // POLICY UPDATES
            </h2>
          </div>
          <p class="text-on-surface-variant font-body-md font-sans leading-relaxed">
            KAAZE reserves the right to modify these Terms and Conditions at any time. Continued use of our website constitutes acceptance of updated terms.
          </p>
        </section>
      </div>

      <!-- Navigation Links -->
      <div class="pt-space-md flex flex-col sm:flex-row items-center justify-between gap-space-sm border-t border-surface-container font-mono font-label-sm text-label-sm">
        <a href="/pages/privacy-policy" class="text-primary hover:underline underline-offset-4 uppercase font-semibold">
          &larr; PRIVACY POLICY
        </a>
        <a href="/pages/shipping-returns" class="text-primary hover:underline underline-offset-4 uppercase font-semibold">
          SHIPPING &amp; LOGISTICS &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Terms & Conditions",
  "settings": []
}
{% endschema %}
