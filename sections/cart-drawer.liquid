{% comment %}
  KAAZE EDTN Slide-Out Quick Cart Drawer Section
  Triggered dynamically via theme.js on header click or quick add.
{% endcomment %}

<div id="cartDrawer" class="hidden fixed inset-0 z-50 overflow-hidden" role="dialog" aria-modal="true" aria-label="Shopping Bag Drawer">
  <!-- Backdrop -->
  <div id="cartDrawerBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>

  <!-- Drawer Container -->
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-surface-container-lowest border-l border-surface-container shadow-2xl flex flex-col justify-between">
      <!-- Top Drawer Header -->
      <div class="p-space-md border-b border-surface-container flex items-center justify-between font-mono">
        <div class="flex items-center gap-2">
          <span class="font-label-md text-label-md uppercase tracking-widest text-primary font-bold">
            [ YOUR BAG // TERMINAL ]
          </span>
          <span class="text-xs text-outline" id="cartDrawerCount">({{ cart.item_count }})</span>
        </div>
        <button
          type="button"
          id="closeCartDrawerBtn"
          class="text-outline hover:text-primary transition-colors p-1 cursor-pointer"
          aria-label="Close cart drawer"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <!-- Line Items Scrollable Container -->
      <div id="cartDrawerItems" class="flex-1 overflow-y-auto p-space-md flex flex-col divide-y divide-surface-container font-mono">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            <div class="py-space-sm flex gap-space-sm">
              <div class="w-16 h-20 bg-surface-container flex-shrink-0 overflow-hidden">
                {% if item.image != blank %}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    alt="{{ item.title | escape }}"
                    class="w-full h-full object-cover grayscale contrast-125"
                    width="64"
                    height="80"
                  >
                {% endif %}
              </div>
              <div class="flex flex-col justify-between flex-1 min-w-0">
                <div>
                  <h4 class="font-title-lg text-xs font-bold text-primary uppercase font-sans line-clamp-1">
                    {{ item.product.title }}
                  </h4>
                  {% unless item.product.has_only_default_variant %}
                    <span class="text-[10px] text-outline uppercase block mt-0.5">
                      {{ item.variant.title }}
                    </span>
                  {% endunless %}
                  <span class="text-xs text-primary font-bold block mt-1">
                    {{ item.final_line_price | money }}
                  </span>
                </div>
                <div class="flex items-center justify-between text-xs pt-1">
                  <span class="text-outline">QTY: {{ item.quantity }}</span>
                  <a
                    href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
                    class="text-outline hover:text-red-500 text-[10px] uppercase"
                  >
                    [REMOVE]
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="py-space-xl text-center text-outline text-xs uppercase">
            BAG IS CURRENTLY EMPTY
          </div>
        {% endif %}
      </div>

      <!-- Bottom Summary & Checkout Actions -->
      <div class="p-space-md border-t border-surface-container bg-surface-container-low font-mono flex flex-col gap-space-sm">
        <div class="flex items-center justify-between text-sm">
          <span class="text-outline uppercase">SUBTOTAL</span>
          <span class="text-primary font-bold" id="cartDrawerSubtotal">{{ cart.total_price | money }}</span>
        </div>

        <form action="{{ routes.cart_url }}" method="post">
          <button
            type="submit"
            name="checkout"
            class="w-full py-3 bg-primary text-on-primary font-label-md text-label-md uppercase tracking-widest font-bold border border-primary hover:bg-surface-container-high hover:text-primary transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <span class="material-symbols-outlined text-[16px]">lock</span>
            <span>DIRECT CHECKOUT</span>
          </button>
        </form>

        <a
          href="{{ routes.cart_url }}"
          class="w-full py-2 text-center text-xs text-outline hover:text-primary uppercase tracking-wider transition-colors border border-surface-container"
        >
          VIEW FULL CART TERMINAL &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
