{% comment %}
  KAAZE EDTN Category Directory Grid Section
{% endcomment %}

<section class="w-full bg-surface-container-lowest px-margin md:px-margin-tablet lg:px-margin-desktop py-space-xl border-t border-b border-surface-container">
  <div class="flex items-center justify-between border-b border-surface-container pb-space-sm mb-space-lg font-mono">
    <span class="font-label-sm text-label-sm text-outline tracking-widest uppercase">
      {{ section.settings.eyebrow | default: '[ SPEC // SECTOR CLASSIFICATION ]' }}
    </span>
    <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">
      {{ section.settings.tag | default: 'ARCHIVE CATEGORIES' }}
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter-desktop">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: routes.all_products_collection_url }}"
        class="group relative flex flex-col justify-between aspect-[3/4] p-space-md border border-surface-container hover:border-primary overflow-hidden transition-all duration-200 bg-surface-container"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.title | escape }}"
            class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            width="800"
            height="1066"
          >
        {% elsif block.settings.fallback_image_url != blank %}
          <img
            src="{{ block.settings.fallback_image_url }}"
            alt="{{ block.settings.title | escape }}"
            class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            width="800"
            height="1066"
          >
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

        <div class="relative z-10 font-mono text-[10px] text-white/70 tracking-widest uppercase">
          {{ block.settings.index_tag | default: '01/DIR' }}
        </div>

        <div class="relative z-10 flex flex-col gap-1">
          <span class="font-display-lg text-headline-lg uppercase text-white font-bold tracking-tight">
            {{ block.settings.title }}
          </span>
          <span class="font-label-sm text-label-sm text-white/80 font-mono tracking-wider line-clamp-1">
            {{ block.settings.subtitle }}
          </span>
          <div class="mt-2 flex items-center gap-1 text-white font-mono text-xs uppercase tracking-widest group-hover:translate-x-1 transition-transform">
            <span>EXPLORE</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

